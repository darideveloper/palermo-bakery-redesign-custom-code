# .gitignore
# Ignore proposals
openspec/changes/*

# Do not ignore archived proposals
!openspec/changes/archive/

# skip docs
docs/

# ignore by default all hiden folders (like agents folders)
.*/

# ignore client docs
client-docs/

check*
node_modules
package*

# Agent & Tooling specific
skills-lock.json

# Project-specific temporary/utility files
test-popup-form.html
fix-gallery-thumbnail-src.php

# OS-specific
.DS_Store
Thumbs.db
